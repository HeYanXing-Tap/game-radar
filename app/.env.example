# 模型：任何 OpenAI 兼容接口都行（DeepSeek / 千问 / 智谱 / 本地 vLLM）
# 把这个文件复制成 .env，然后填你自己的 key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-key-here

# 可选
# LLM_CHEAP_MODEL=            # 预筛用的便宜模型（留空则用上面的）
# LLM_REVIEW_MODEL=           # 聚簇复核单独换一家模型
# LLM_CONCURRENCY=4           # 并发请求数
# LLM_MAX_CALLS_PER_RUN=400   # 单次运行调用上限（防跑飞）
# LLM_TIMEOUT_MS=120000
# PORT=7317
# FETCH_DELAY_MS=1200         # 同域名抓取间隔
# FETCH_UA=                   # 自定义 UA
